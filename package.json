{
  "name": "the-uncut",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "lint": "eslint .",
    "watch": "rm -rf .parcel-cache && rm -rf dist && parcel watch ./src/index.js ./src/theme.scss ./src/editor.scss",
    "build": "rm -rf .parcel-cache && rm -rf dist && parcel build ./src/index.js ./src/theme.scss ./src/editor.scss",
    "deploy": "npm run build && node scripts/git-commit.js && node scripts/deploy.js",
    "deploy:force": "npm run build && node scripts/git-commit.js && DEPLOY_FORCE=true node scripts/deploy.js",
    "ssh": "node scripts/ssh-connect.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@barba/core": "^2.10.0",
    "@parcel/transformer-sass": "^2.13.3",
    "autocomplete": "^0.0.1",
    "cssnano": "^5.0.6",
    "flickity": "^3.0.0",
    "fullpage.js": "^4.0.22",
    "matter-js": "^0.19.0",
    "parcel": "^2.13.3",
    "postcss": "^8.3.5"
  },
  "postcss": {
    "plugins": {
      "cssnano": {}
    }
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "eslint": "^7.31.0",
    "ftp-deploy": "^2.4.3",
    "parcel-namer-rewrite": "^2.0.0-rc.2",
    "parcel-reporter-bundle-manifest": "^1.0.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "parcel-namer-rewrite": {
    "chain": "@parcel/namer-default",
    "rules": {
      "theme.css": "theme{.hash}.css",
      "index.js": "index{.hash}.js"
    }
  }
}
