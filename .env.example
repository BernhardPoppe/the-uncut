# SFTP Deploy + SSH (easyname)
# Kopieren: cp .env.example .env
#
# easyname: gleicher User/Passwort wie FTP, Port 22
# Terminal: ssh USERNAME@HOSTNAME -p 22

SFTP_HOST=web16.wh20.easyname.systems
SFTP_PORT=22
SFTP_USER=dein-ftp-benutzername
SFTP_PASSWORD=dein-ftp-passwort

SFTP_REMOTE_PATH=/the-uncutcom/wp-content/themes/the-uncut

# Optional: Private Key statt Passwort
# SFTP_PRIVATE_KEY=~/.ssh/id_ed25519
# SFTP_PASSPHRASE=
